[importlinter]
root_packages =
    ferrum
include_external_packages = True

[importlinter:contract:cli-isolation]
name = CLI and contrib are not imported by core query modules
type = forbidden
source_modules =
    ferrum.models
    ferrum.queryset
    ferrum.connection
    ferrum.hooks
    ferrum.errors
    ferrum.migrations
forbidden_modules =
    ferrum.cli
    ferrum.contrib
    typer
    rich
    fastapi
    starlette

# Contract 2: contrib must not be imported by core.
[importlinter:contract:contrib-isolation]
name = contrib is not imported by core
type = forbidden
source_modules =
    ferrum.models
    ferrum.queryset
    ferrum.connection
    ferrum.hooks
    ferrum.errors
    ferrum.migrations
    ferrum.cli
forbidden_modules =
    ferrum.contrib

# Contract 3: core must not import CLI.
# A forbidden contract, not a layers contract: the query path legitimately
# imports connection, errors and hooks, which a strict layer order rejects.
[importlinter:contract:core-does-not-import-cli]
name = core query path does not import CLI
type = forbidden
source_modules =
    ferrum.queryset
    ferrum.connection
    ferrum.hooks
    ferrum.errors
    ferrum.migrations
    ferrum.config
forbidden_modules =
    ferrum.cli
